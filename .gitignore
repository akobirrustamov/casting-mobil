# Maven

# ⚠️ `.mvn/` ni BUTUNLAY chiqarib bo'lmaydi.
#
# Git papkaning o'zi chiqarilgan bo'lsa, ICHIDAGI inkorlarni umuman
# ko'rmaydi — shuning uchun quyidagi `!` qatori ilgari ishlamasdi va
# toza klonda `./mvnw` ishga tushmasdi:
#
#     Could not find or load main class
#     org.apache.maven.wrapper.MavenWrapperMain
#
# Wrapper'ning butun ma'nosi — Maven o'rnatmasdan qurish. Uni
# yashirish o'sha ma'noni bekor qiladi.
#
# Shuning uchun papka emas, ICHIDAGILAR chiqariladi va wrapper
# qaytariladi. `maven-wrapper.jar` uchun alohida inkor kerak, chunki
# yuqoridagi `*.jar` uni ham tutadi.
.mvn/*
!.mvn/wrapper/
.mvn/wrapper/*
!.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties

# Gradle

.gradle/
build/

# ======================

# Application Config (MUHIM 🔥)

# ======================

application.properties
application.yml
application-*.properties
application-*.yml

# ⚠️ `dev` va `schemagen` profillari REPOZITORIYDA turishi kerak.
#
# Ularni yashirish 43 ta sozlamani yo'qotardi va toza klonda
# `--spring.profiles.active=dev` hech narsa qilmasdi.
#
# Ularda sir yo'q va bo'lishi ham mumkin emas: qiymatlar ataylab
# o'zini tanitadi (`dev...`, `schemagen...`), buni esa
# `packagedConfigHasNoSecretDefaults` testi qo'riqlaydi.
#
# ⚠️ `src/main/resources/application.properties` YASHIRIN QOLADI —
# unda haqiqiy panel parollari bor (pastdagi qatorga qarang).
!application-dev.properties
!application-schemagen.properties

# agar resources ichida bo‘lsa:

src/main/resources/application.properties
src/main/resources/application.yml

# ⚠️ Test konfiguratsiyasi ISTISNO — u repozitoriyda turishi SHART.
#
# Unda hech qanday sir yo'q (parol `application.properties` dan meros
# olinadi, JWT kaliti esa faqat testlar uchun yasalgan). Lekin usiz
# butun test to'plami ishlab chiquvchining shaxsiy bazasiga ulanadi va
# 758 testdan 625 tasi «Found non-empty schema but no schema history
# table» bilan yiqiladi — kod butunlay to'g'ri bo'lsa ham.
# ⚠️ Yo'l repozitoriy ILDIZIDAN yoziladi. Ilgari bu yerda
# `!src/test/resources/...` turardi — ichida `/` bor naqsh esa aynan
# `.gitignore` turgan papkaga bog'lanadi, ya'ni u `backend/src/...` ga
# HECH QACHON tushmasdi. Natijada istisno yozilgan, lekin ishlamagan:
# fayl repozitoriyda yo'q va toza klonda testlar ishga tushmaydi.
!backend/src/test/resources/application-test.properties

# ⚠️ LOCAL profili ham ISTISNO — u ham repozitoriyda turishi SHART.
#
# Unda ham sir yo'q: baza xotiradagi H2, JWT kaliti faqat shu stend
# uchun, Eskiz kabineti umuman ishlatilmaydi (`LoggingSmsClient` kodni
# logga yozadi).
#
# ⚠️ Usiz mobile/docs/LOCAL_BACKEND.md dagi ko'rsatma YOLG'ON bo'ladi:
# hujjatda `--spring.profiles.active=local` yozilgan, lekin fayl
# repozitoriyga hech qachon tushmagani uchun toza klonda u hech narsa
# qilmasdi — ilova ishlab chiquvchining shaxsiy Postgres'iga ulanardi.
!backend/src/main/resources/application-local.properties


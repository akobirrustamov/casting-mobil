{
  "expo": {
    "name": "UzCasting",
    "slug": "uzcasting",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": [
      "uzcasting",
      "uz.uzcasting.app"
    ],
    "userInterfaceStyle": "dark",
    "updates": {
      "url": "https://u.expo.dev/705e3238-9b8c-4676-9099-556e01afa79b"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "backgroundColor": "#05050A",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.uzcasting.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "uz.uzcasting.app",
      "adaptiveIcon": {
        "backgroundColor": "#05050A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "backgroundColor": "#05050A",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-video",
      "expo-web-browser",
      "expo-localization",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#05050A",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "UzCasting kasting arizasiga rasmlaringizni biriktirish uchun galereyaga ruxsat so'raydi.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "705e3238-9b8c-4676-9099-556e01afa79b"
      }
    },
    "owner": "diyorbekjumayev1"
  }
}

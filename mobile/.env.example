# Скопировать в .env и заполнить. .env в git не попадает.

# Бэкенд. По умолчанию прод сайта.
EXPO_PUBLIC_API_URL=https://uzcasting.site

# Защита от записи в боевую базу. false — только осознанно.
EXPO_PUBLIC_READ_ONLY=true

# OAuth-клиенты Google — см. docs/GOOGLE_AUTH.md.
# Нужны три разных клиента, а не один.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Временный вход в обход Google — ТОЛЬКО для локального бэкенда.
# Пустые значения = обхода нет. Работает лишь при __DEV__ и READ_ONLY=false.
# Подробности — src/features/auth/devLogin.ts.
EXPO_PUBLIC_DEV_LOGIN_PHONE=
EXPO_PUBLIC_DEV_LOGIN_PASSWORD=

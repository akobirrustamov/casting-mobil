# Скопировать в .env и заполнить. .env в git не попадает.

# Бэкенд. Не задано — берётся боевой домен из src/lib/api.ts.
#
#   локальный стенд   http://<IP машины>:8099   (docs/LOCAL_BACKEND.md)
#   боевой            http://uzcasting.com
#
# ⚠️ IP машины, не localhost: для телефона localhost — это он сам.
# ⚠️ EXPO_PUBLIC_* вшиваются в бандл при сборке — после правки
#    перезапустить Metro, иначе значение останется старым.
EXPO_PUBLIC_API_URL=http://192.168.1.1:8099

# Защита от записи. По умолчанию включена; на стенде и в сборках EAS
# снимается, иначе вход, избранное и аналитика не работают.
EXPO_PUBLIC_READ_ONLY=false

# OAuth-клиенты Google — см. docs/GOOGLE_AUTH.md.
# Нужны три разных клиента, а не один.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Временный вход в обход Google — ТОЛЬКО для локального бэкенда.
# Пустые значения = обхода нет. Работает лишь при __DEV__ и READ_ONLY=false.
# Подробности — src/features/auth/devLogin.ts.
EXPO_PUBLIC_DEV_LOGIN_PHONE=
EXPO_PUBLIC_DEV_LOGIN_PASSWORD=

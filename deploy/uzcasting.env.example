# ==========================================================================
#  UZCASTING — server sirlari
# ==========================================================================
#  Bu faylni `uzcasting.env` nomi bilan nusxalang va qiymatlarni
#  to'ldiring. Nusxa `.gitignore` da — u repozitoriyga tushmaydi.
#
#  ⚠️ NEGA JAR ICHIDA EMAS
#  Jar'ni olgan har kim uni ochib o'qiy oladi:
#      unzip -p backend.jar BOOT-INF/classes/application.properties
#  Jar esa `scp` bilan yuboriladi, `/tmp` da yotadi, zaxira nusxaga
#  tushadi. Sir esa faqat serverda, 600 huquqli faylda turishi kerak.
#
#  Serverda:
#      sudo install -m 600 -o uzcasting -g uzcasting \
#           uzcasting.env /opt/uzcasting/uzcasting.env
# ==========================================================================

# --------------------------------------------------------------- MAJBURIY
#  Butun ilovada sukut qiymati YO'Q bo'lgan yagona sozlama.
#  Berilmasa ilova ko'tarilmaydi — bu ataylab: jimgina, lekin
#  himoyasiz ishlashdan darhol yiqilgani yaxshi.
#
#  ⚠️ Bir marta yasang va SAQLANG. Almashtirsangiz barcha
#  foydalanuvchilar tizimdan chiqib ketadi.
#
#      openssl rand -hex 32
APP_JWT_SECRET=

# ------------------------------------------------------------------ BAZA
#  PostgreSQL'da yaratgan parolingiz:
#      create user uzcasting with password '<PAROL>';
DB_URL=jdbc:postgresql://localhost:5432/casting
DB_USERNAME=uzcasting
DB_PASSWORD=

# -------------------------------------------------------------------- S3
#  Timeweb Object Storage panelidan.
#  ⚠️ Bucketda CORS sozlanishi shart — katta fayl brauzerdan
#  TO'G'RIDAN-TO'G'RI bucketga ketadi (server_config.md §4.2).
STORAGE_PROVIDER=s3
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ------------------------------------------------------------------- CDN
#  Origin = S3 bucket. So'rov qatori origin'ga uzatilishi shart:
#  segment imzosi aynan o'sha yerda (server_config.md §5).
CDN_BASE_URL=https://cdn.uzcasting.site

# ------------------------------------------------------------- TRANSCODING
#  12 yadroli server uchun 3. Kichikroq serverda kamaytiring.
VIDEO_MAX_JOBS=3
VIDEO_MIN_FREE_DISK=10GB
VIDEO_TEMP_DIR=/opt/uzcasting/files/.transcoding

# ------------------------------------------------------------------ DOMEN
#  ⚠️ Panel API bilan bitta domendan beriladi, ya'ni unga CORS kerak
#  emas. Bu sozlama MOBIL ILOVA uchun.
CORS_ORIGINS=https://uzcasting.site

# -------------------------------------------------------------------- SMS
#  Eskiz hisobingiz. Bo'sh bo'lsa SMS yuborilmaydi va OTP orqali
#  kirish ishlamaydi — lekin ilova baribir ko'tariladi.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# ------------------------------------------------------------ BIRINCHI HISOB
#  ⚠️ FAQAT BIRINCHI ISHGA TUSHIRISH UCHUN.
#
#  Hisob yaratilgach bu ikki qatorni O'CHIRING va xizmatni qayta
#  ishga tushiring. Parol serverda faylda turishi shart emas.
#
#  Bo'sh qoldirilsa hisob umuman yaratilmaydi — ya'ni tasodifan
#  zaif parolli admin paydo bo'lmaydi.
APP_GIPERSUPERADMIN_PHONE=
APP_GIPERSUPERADMIN_PASSWORD=

# Frontend konfiguratsiyasi.
# Bu faylni ".env" nomi bilan nusxalab, qiymatlarni o'zgartiring.

# Backend manzili.
#
# ⚠️ ISHLAB CHIQARISH BUILDIDA BU FAYL BO'LISHI SHART.
#
# Qiymat build paytida bundle ICHIGA qotib qoladi. Fayl bo'lmasa
# `http://localhost:8080` yoziladi va foydalanuvchi brauzeri o'z
# kompyuteriga murojaat qiladi — sayt ishlamaydi, konsolda esa
# localhost'ga so'rov ko'rinadi.

# Ishlab chiqish:
REACT_APP_API_URL=http://localhost:8080

# ⚠️ ISHLAB CHIQARISH uchun — BO'SH qoldiring:
#
# Panel jar ichidan beriladi, ya'ni API bilan bitta domenda turadi.
# Bo'sh qiymat «xuddi shu domen» degani: manzillar nisbiy bo'ladi,
# domen o'zgarsa qayta yig'ish kerak emas va CORS umuman kerak
# bo'lmaydi.
#
# REACT_APP_API_URL=

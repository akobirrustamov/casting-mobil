<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.1.2</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.example</groupId>
    <artifactId>backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>backend</name>
    <description>backend</description>
    <properties>
        <java.version>17</java.version>

        <!--
          ⚠️ Lombok versiyasi Spring Boot ota-pom'idagidan (1.18.28) ATAYLAB
          yuqoriroq.

          Lombok annotatsiya protsessori JDK ning ichki API'lariga tayanadi va
          har bir yangi JDK bilan uni yangilash kerak. 1.18.28 JDK 21 gacha
          ishlaydi; JDK 24-25 da esa u JIM ISHDAN CHIQADI — xato bermaydi,
          shunchaki hech qanday getter/builder generatsiya qilinmaydi va
          kompilyator yuzlab «cannot find symbol» beradi.

          Loyiha `<java.version>17</java.version>` bilan quriladi, lekin
          ishlab chiquvchining mashinasida yangiroq JDK turishi mumkin.
          1.18.44 JDK 17 dan 25 gacha ishlaydi, ya'ni bu ko'tarish hech
          narsani buzmaydi.
        -->
        <lombok.version>1.18.44</lombok.version>
    </properties>
    <dependencies>






        <dependency>
            <groupId>net.sf.ucanaccess</groupId>
            <artifactId>ucanaccess</artifactId>
            <version>5.0.1</version>
        </dependency>




        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>5.2.3</version> <!-- Use the latest version available -->
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.3</version> <!-- Use the latest version available -->
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml-schemas</artifactId>
            <version>4.1.2</version> <!-- Use the latest version available -->
        </dependency>











        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean Validation - request DTO'larni tekshirish uchun (@NotBlank, @Size...).
             Spring Boot 3'da web starter'ga kirmaydi, alohida qo'shiladi. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Flyway - sxema migratsiyalari.
             Ilgari sxemani Hibernate'ning ddl-auto=update boshqarardi: o'zgarish
             nazoratsiz, rollback yo'q, review yo'q edi. Endi har bir o'zgarish
             db/migration ostidagi versiyalangan SQL fayl. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- AOP - @RequirePermission annotatsiyasi uchun.
             Ruxsat tekshiruvi qo'lda chaqirilganda uni unutish oson;
             annotatsiya buni metod imzosida ko'rinadigan qiladi. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Faqat lokal ishga tushirish uchun: telefon/mobil ilovani sinash paytida
            Postgres va parol talab qilinmasin. Prod'da application.properties'dagi
            datasource Postgres'ga ko'rsatadi, H2 umuman ishlatilmaydi.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- https://mvnrepository.com/artifact/io.jsonwebtoken/jjwt-impl -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.11.5</version>
        </dependency>
        <!-- https://mvnrepository.com/artifact/io.jsonwebtoken/jjwt-api -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.11.5</version>
        </dependency>
        <!-- Google ID token tekshirish uchun (mobil ilovadan Google login) -->
        <dependency>
            <groupId>com.google.api-client</groupId>
            <artifactId>google-api-client</artifactId>
            <version>2.7.0</version>
        </dependency>
        <!-- https://mvnrepository.com/artifact/io.jsonwebtoken/jjwt-jackson -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>
        <!--
            OpenAPI (ТЗ §106). Mobil va frontend jamoasi endpointni backend
            kodini o'qimasdan ishlata olishi kerak.

            Yangi bog'liqlik ataylab: mavjud annotatsiyalardan hujjat
            hosil qiladi, qo'shimcha kod talab qilmaydi va Spring Boot
            uchun standart yechim (ТЗ §70 - "real muammoni hal qilsin").
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.2.0</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Java 17 Compiler -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!--
                  ⚠️ 3.11.0 dan ko'tarildi. Sabab `proc` parametri: u faqat
                  3.13.0 dan boshlab mavjud, quyida esa usiz ilojimiz yo'q.
                -->
                <version>3.13.0</version>
                <configuration>
                    <!--
                      `source`/`target` o'rniga `release`: u JDK ning ichki
                      API'larini ham bloklaydi, ya'ni 17 da yo'q metod
                      tasodifan ishlatilsa kompilyatsiya paytida tutiladi,
                      ishga tushganda emas.
                    -->
                    <release>${java.version}</release>

                    <!--
                      ⚠️ `full` MAJBURIY.

                      JDK 23 dan boshlab `javac` faqat classpath'da topilgan
                      annotatsiya protsessorlarini SUKUT BO'YICHA O'CHIRADI
                      (JEP 'Prepare to Restrict The Use of JDK-Internal APIs'
                      bilan bir qatorda kelgan o'zgarish). Natijada Lombok
                      indamay ishlamay qo'yadi va butun loyiha
                      «cannot find symbol: method builder()» bilan yiqiladi —
                      xatoda Lombok so'zi umuman uchramaydi, shuning uchun
                      sababni topish qiyin.
                    -->
                    <proc>full</proc>

                    <!--
                      Protsessor yo'lini OCHIQ ko'rsatamiz: shunda u
                      classpath'dagi tasodifiy tartibga bog'liq bo'lmaydi va
                      qurilish har qanday JDK da bir xil ishlaydi.
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>

# ==========================================================================
#  Environment o'zgaruvchilari - NAMUNA
# ==========================================================================
#
# Bu fayl git'ga tushadi va HAQIQIY qiymatlarni O'Z ICHIGA OLMAYDI.
# Haqiqiy qiymatlar serverda environment orqali beriladi.
#
# Ishga tushirish misoli:
#   export DB_PASSWORD='...'
#   export APP_JWT_SECRET='...'
#   java -jar backend/target/backend-0.0.1-SNAPSHOT.jar

# --- Ma'lumotlar bazasi ---
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=<parolni shu yerga emas, environmentga qo'ying>

# --- JWT ---
# Kamida 32 bayt (64 hex belgi). Yangi kalit generatsiyasi:
#   openssl rand -hex 32
#
# ⚠️ DEPLOY PAYTIDA MUHIM:
# Ilgari bu kalit JwtService.java ichida qotirilgan edi. Agar mavjud
# foydalanuvchi sessiyalari saqlanib qolishi kerak bo'lsa, APP_JWT_SECRET ga
# O'SHA eski qiymat berilishi kerak (u git tarixida, JwtService.java da).
# Aks holda barcha tokenlar yaroqsiz bo'ladi va hamma qaytadan kiradi.
#
# Tavsiya: kalitni ALMASHTIRING (u ochiq repozitoriyda turgan edi) va
# foydalanuvchilarning qayta kirishini qabul qiling.
APP_JWT_SECRET=<openssl rand -hex 32>

# Muddatlar (ms). Berilmasa: access 900 000 (15 daqiqa),
# refresh 86 400 000 (24 soat).
#
# ⚠️ Access token QISQA bo'lishi kerak (§61). Ilgari u 6 000 000 ms =
# 100 daqiqa edi va bu «qisqa muddatli» degani emas: o'g'irlangan token
# deyarli ikki soat ishlayverardi. Panel muddati tugaganda tokenni
# avtomatik yangilaydi, ya'ni foydalanuvchi buni sezmaydi.
APP_JWT_ACCESS_TOKEN_MS=900000
APP_JWT_REFRESH_TOKEN_MS=86400000

# --- Kirish himoyasi (§61) ---
# Hisob bo'yicha: necha xatodan keyin va necha daqiqaga bloklanadi.
# IP bo'yicha cheklov alohida ishlaydi (RateLimitFilter).
APP_AUTH_MAX_FAILED_ATTEMPTS=5
APP_AUTH_LOCKOUT_MINUTES=15

# ⚠️ Refresh token `Secure` cookie'da yuboriladi, ya'ni FAQAT HTTPS
# orqali. Mahalliy `http://localhost` da sinash uchun `false` qiling —
# lekin ishlab chiqarishda HECH QACHON.
APP_AUTH_COOKIE_SECURE=true

# --- Vaqt mintaqasi (§68) ---
# Konteynerlarda sukut bo'yicha UTC bo'ladi, admin esa panelga Toshkent
# vaqtini kiritadi. Sozlanmasa rejalashtirilgan premyera va reklama
# besh soat kech chiqadi.
APP_TIMEZONE=Asia/Tashkent

# --- Yashirin master hisoblar (AutoRun) ---
#
# ⚠️ Parol berilmasa hisob YARATILMAYDI va logga ogohlantirish
# yoziladi. Bu ataylab: bo'sh yoki standart parolli master hisob
# ochiq eshikdan yomonroq, chunki uni hech kim ko'rmaydi.
#
# Bular panelning xodimlar ro'yxatida KO'RINMAYDI - tizim egasining
# zaxira kaliti.
APP_SUPERADMIN_PHONE=
APP_SUPERADMIN_PASSWORD=
APP_GIPERSUPERADMIN_PHONE=
APP_GIPERSUPERADMIN_PASSWORD=

# --- Panel hisoblari (AutoRun) ---
#
# Master hisoblardan farqli: bular xodimlar ro'yxatida ko'rinadi va
# ular ustida odatdagi amallar bajariladi.
#
# ⚠️ WORKER hech qanday ruxsatsiz yaratiladi - ruxsatni Admin panel
# orqali beradi va bu amal auditga tushadi (ТЗ §12).
APP_ADMIN_PHONE=admin
APP_ADMIN_PASSWORD=
APP_WORKER_PHONE=worker
APP_WORKER_PASSWORD=

# --- Google OAuth (mobil ilova uchun) ---
APP_GOOGLE_CLIENT_IDS=

# --- SMS (Eskiz.uz) — telefon orqali ro'yxatdan o'tish/kirish uchun OTP ---
# https://notify.eskiz.uz kabinetidagi email/parol. Berilmasa
# /api/v1/auth/otp/send 503 (SMS_NOT_CONFIGURED) qaytaradi — soxta
# muvaffaqiyat yo'q, xuddi Google login sozlanmaganda kabi.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Tasdiqlangan nickname (Eskiz kabinetida "Nicknames"). Moderatsiyadan
# o'tmagan hisobda standart "4546" bilan FAQAT test matnlari ketadi
# ("Bu Eskiz dan test" va sh.k.) va FAQAT whitelist raqamiga — haqiqiy
# OTP matni ("UzCasting platformasida ro'yxatdan o'tish uchun tasdiqlash
# kod: ...", kabinetda shablon #85892 sifatida yuborilgan) moderatsiya
# tasdiqlanmaguncha yetib bormaydi. Bu Eskiz tomonidagi cheklov.
ESKIZ_SMS_FROM=4546

# Kod necha soniya amal qiladi / qayta yuborish oralig'i / urinishlar chegarasi.
# Qayta yuborish - 2 daqiqa: undan oldin so'ralsa 429 OTP_COOLDOWN qaytadi.
APP_OTP_TTL_SECONDS=180
APP_OTP_RESEND_COOLDOWN_SECONDS=120
APP_OTP_MAX_ATTEMPTS=5

# --- Hali ulanmagan servislar ---
# ⚠️ Bular berilmaguncha tegishli imkoniyat SOXTA muvaffaqiyat
# qaytarmaydi: bildirishnoma FAILED holatda saqlanadi, to'lov esa 503
# beradi (§44, §32).
# FCM_KEY=
# PAYMENT_PROVIDER=
# PAYMENT_MERCHANT_ID=
# PAYMENT_SECRET_KEY=

# ── Ma'lumotlar bazasi ───────────────────────────────────────────────
#
# ⚠️ Har bir qiymat `${NOM:zaxira}` shaklida. Zaxirasiz `${NOM}` yozish
# — eng oson va eng jimgina xato: lokalda `dev` profili bu qatorlarga
# yetib bormaydi, prod'da esa ilova ko'tarilmaydi.
#
# Buni `ConfigurationPlaceholderTest` qo'riqlaydi.
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/casting}
spring.datasource.username=${DB_USERNAME:postgres}

# ⚠️ MAXFIY. Bu yerga YOZMANG — environment orqali bering:
#   export DB_PASSWORD='...'
spring.datasource.password=${DB_PASSWORD:}

# ── Sxema siyosati (ТЗ §91) ──────────────────────────────────────────
#
# Sxemani FAQAT Flyway boshqaradi. Hibernate unga tegmaydi: aks holda
# ishlab turgan bazaning sxemasi hech qayerda yozilmagan holatga kelib
# qoladi va keyingi migratsiya nima ustiga tushishi noma'lum bo'ladi.
spring.jpa.hibernate.ddl-auto=none

# Ishlab turgan bazani tozalash imkoniyati YOPIQ.
spring.flyway.clean-disabled=true

# ── Xato javoblari (ТЗ §94) ──────────────────────────────────────────
#
# Stacktrace va istisno nomi klientga HECH QACHON yuborilmaydi: ular
# ichki tuzilishni, paket nomlarini va ba'zan so'rov parametrlarini
# ochib beradi.
#
# Sukut qiymatga tayanilmaydi — u Spring versiyasi bilan o'zgarishi
# mumkin va bu jimgina o'zgarish bo'lardi.
server.error.include-stacktrace=never
server.error.include-exception=false

# ── Fayl saqlash: lokal disk yoki Timeweb S3 ─────────────────────────
#
# `local`  — fayllar `backend/files/` da (sukut, hech narsa o'zgarmaydi)
# `s3`     — YANGI fayllar Timeweb Object Storage'ga
#
# ⚠️ `s3` tanlansa-yu quyidagi to'rt qiymatdan biri berilmasa, ilova
# ISHGA TUSHMAYDI va nima yetishmayotganini aytadi. Bu ataylab: yarim
# sozlangan S3 jimgina lokal diskka qaytardi va buni faqat prod'da,
# fayllar noto'g'ri joyda ekanini ko'rib bilinardi.
#
# ⚠️ Eski fayllar S3 yoqilgandan keyin ham LOKAL diskdan o'qilishda
# davom etadi (`RoutingStorageService`). Ularni ko'chirish alohida
# qaror talab qiladi.
# ==========================================================================
#  Yuklanadigan fayl hajmi
# ==========================================================================
#  ⚠️ Bu satrlar BO'LMASA Spring sukut bo'yicha 1 MB qo'yadi va 2 MB lik
#  afisha ham yuklanmaydi. Xato esa «Maximum upload size exceeded» —
#  admin uni fayl bilan bog'liq deb o'ylardi.
#
#  8 MB dan katta fayl baribir bo'laklab yuklanadi (panel o'zi
#  tanlaydi), ya'ni bu chegara faqat kichik fayllarga tegishli.
spring.servlet.multipart.max-file-size=${MAX_UPLOAD_SIZE:50MB}
spring.servlet.multipart.max-request-size=${MAX_UPLOAD_SIZE:50MB}

# ==========================================================================
#  CORS
# ==========================================================================
#  ⚠️ Sukut qiymat `*` — bu FAQAT ishlab chiqish uchun. Ishlab
#  chiqarishda aniq domen yoziladi, aks holda istalgan sayt
#  foydalanuvchi brauzeri orqali API'ga murojaat qila oladi.
#
#  Panel va API bitta domendan berilsa (jar ichidagi statik fayllar),
#  bu yerda faqat mobil ilova uchun kerak bo'lgan manzillar qoladi.
app.cors.allowed-origins=${CORS_ORIGINS:https://uzcasting.site}

# ==========================================================================
#  Birinchi ishga tushirish
# ==========================================================================
#  ⚠️ ISHLAB CHIQARISHDA DOIM `false`.
#
#  `true` bo'lsa zaif parolli hisoblar yaratiladi (`12345678`). U faqat
#  lokal stend uchun. Sukut qiymat allaqachon `false` — bu satr shuning
#  uchun ATAYLAB izohda qoldirilgan, uni yoqish ongli qaror bo'lsin.
# app.bootstrap.allow-weak-password=false

app.storage.provider=${STORAGE_PROVIDER:local}

app.storage.s3.endpoint=${S3_ENDPOINT:https://s3.twcstorage.ru}
app.storage.s3.region=${S3_REGION:ru-1}
app.storage.s3.bucket=${S3_BUCKET:}

# ⚠️ MAXFIY. Bu yerga YOZMANG — environment orqali bering:
#   export S3_ACCESS_KEY='...'
#   export S3_SECRET_KEY='...'
app.storage.s3.access-key=${S3_ACCESS_KEY:}
app.storage.s3.secret-key=${S3_SECRET_KEY:}

# Presigned havolaning amal qilish muddati. 20 GB lik faylni sekin
# kanalda yuklashga yetishi kerak, lekin bir ish kunidan qisqa bo'lsin.
app.storage.s3.upload-url-ttl=${S3_UPLOAD_URL_TTL:6h}

# ── Video: transcoding va CDN ────────────────────────────────────────
#
# ⚠️ CDN ildizi. Bo'sh bo'lsa HLS manzillari BERILMAYDI va klient eski
# yo'lga (`/api/v1/app/media/{id}/raw`) qaytadi.
#
# Bu ataylab: sozlanmagan CDN uchun o'ylab topilgan manzil qaytarish
# pleyerni ishlamaydigan havolaga yuborardi va nosozlik «video buzuq»
# bo'lib ko'rinardi — sabab esa oddiy sozlama yetishmasligi edi.
app.video.cdn.base-url=${CDN_BASE_URL:}

# ==========================================================================
#  Pullik video himoyasi (§4.10)
# ==========================================================================
#  Playlist bizning server orqali beriladi (huquq tekshiriladi),
#  segmentlar esa IMZOLANGAN havola bilan to'g'ridan-to'g'ri ombordan
#  keladi. Video hech qachon Spring Boot orqali oqmaydi.
#
#  ⚠️ Imzolash faqat `app.storage.provider=s3` bo'lganda ishlaydi.
#  Lokal omborda eski xatti-harakat saqlanadi: to'g'ridan CDN manzili.
# ==========================================================================

# Chipta amal qilish muddati — u KIMLIGINI aytadi, huquq bermaydi.
# Huquq har so'rovda `AccessService` dan qayta so'raladi, shuning uchun
# obuna tugasa kirish o'sha zahoti yopiladi.
#
# ⚠️ Tomosha seansidan uzun bo'lishi kerak, aks holda odam filmning
# o'rtasida «playlist ochilmadi» xatosiga tushardi.
app.video.ticket-ttl=${VIDEO_TICKET_TTL:6h}

# Segment havolasi qancha yashaydi.
#
# ⚠️ Qisqa bo'lsa uzun film o'rtasida uzilardi; uzun bo'lsa sizib
# chiqqan havola shuncha vaqt ishlardi.
app.video.signed-url-ttl=${VIDEO_SIGNED_URL_TTL:4h}

# Imzo keshi oynasi.
#
# ⚠️ Busiz har foydalanuvchi O'Z havolasini olardi (imzoda imzolash
# vaqti bor) va CDN ularni boshqa-boshqa manzil deb hisoblardi:
# 3000 tomoshabin → 3000 kesh yozuvi, ya'ni kesh umuman ishlamasdi.
#
# TTL dan sezilarli KICHIK bo'lishi shart: oyna oxirida berilgan
# havola aks holda deyarli darhol eskirardi.
app.video.signed-url-window=${VIDEO_SIGNED_URL_WINDOW:1h}

# FFmpeg. PATH da bo'lsa nom yetarli, aks holda to'liq yo'l.
app.video.ffmpeg-path=${FFMPEG_PATH:ffmpeg}
app.video.ffprobe-path=${FFPROBE_PATH:ffprobe}

# Bir vaqtda nechta video.
#
# ⚠️ Kod sukuti — BITTA, va u ATAYLAB shunday: FFmpeg butun
# protsessorni egallaydi va u API server bilan ayni mashinada turibdi
# (Docker yo'q, ajratish yo'q). Ishlab chiquvchining noutbukida ikkita
# parallel transcoding ilovani ishlatib bo'lmas holga keltirardi.
#
# ⚠️ ISHLAB CHIQARISHDA — 3.
#
# Tanlangan server 12 yadroli (§4.13). O'lchov: 4K60 manba real
# vaqtdan 2.3× tez o'giriladi, kuniga 30 ta video 12 yadroda 8.3
# soatni egallaydi — bandlik 35%.
#
# Nega aynan 3, ko'proq emas: har bir FFmpeg 4K manbada ~1.5 GB RAM
# oladi. Server 16 GB, undan Spring Boot 1–2 GB va PostgreSQL 2–4 GB
# oladi. To'rtinchi ish PostgreSQL keshini siqib chiqarardi va butun
# saytdagi so'rovlar sekinlashardi — transcoding esa sezilarli
# tezlashmasdi.
app.video.max-concurrent-jobs=${VIDEO_MAX_JOBS:3}

# ⚠️ Ish boshlash uchun kerakli eng kam bo'sh joy.
#
# Disk to'lganda `Files.copy` yarim yo'lda uziladi, ish yiqiladi va
# qayta urinadi — yana yarim fayl yozib. Uchala urinish ham diskni
# yanada to'ldiradi.
#
# Undan ham yomoni: disk to'lgach PostgreSQL ham yozolmay qoladi va
# nosozlik video bilan umuman bog'liq bo'lmagan joyda ko'rinadi.
#
# Joy kam bo'lsa ish UMUMAN olinmaydi va navbatda kutadi — urinishlar
# sarflanmaydi, joy bo'shashi bilan o'z-o'zidan davom etadi.
#
# 200 GB NVMe uchun 10 GB — ~5%. Kichikroq diskda oshiring.
app.video.min-free-disk=${VIDEO_MIN_FREE_DISK:10GB}

# Nechta marta qayta urinamiz. Cheksiz bo'lsa buzuq fayl navbatni
# abadiy band qilardi.
app.video.max-attempts=${VIDEO_MAX_ATTEMPTS:3}

# Transcoding uchun vaqtinchalik papka. Bu yerda manba + barcha
# variantlar turadi, ya'ni bo'sh joy KATTA bo'lishi kerak.
app.video.temp-dir=${VIDEO_TEMP_DIR:backend/files/.transcoding}

# Navbatni qanchada bir tekshirish.
app.video.poll-delay-ms=${VIDEO_POLL_DELAY_MS:15000}

# Sifat zinapoyasi. Bitratelar kodda QOTIRILMAYDI — ular server
# quvvatiga va kanal kengligiga qarab o'zgaradi.
app.video.transcoding.profiles[0].height=1080
app.video.transcoding.profiles[0].video-bitrate=5000k
app.video.transcoding.profiles[0].audio-bitrate=128k
app.video.transcoding.profiles[1].height=720
app.video.transcoding.profiles[1].video-bitrate=2800k
app.video.transcoding.profiles[1].audio-bitrate=128k
app.video.transcoding.profiles[2].height=480
app.video.transcoding.profiles[2].video-bitrate=1200k
app.video.transcoding.profiles[2].audio-bitrate=96k

# ==========================================================================
#  Environment o'zgaruvchilari - NAMUNA
# ==========================================================================
#
# Bu fayl git'ga tushadi va HAQIQIY qiymatlarni O'Z ICHIGA OLMAYDI.
# Haqiqiy qiymatlar serverda environment orqali beriladi.
#
# Ishga tushirish misoli:
#   export DB_PASSWORD='...'
#   export APP_JWT_SECRET='...'
#   java -jar backend/target/backend-0.0.1-SNAPSHOT.jar

# --- Ma'lumotlar bazasi ---
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=<parolni shu yerga emas, environmentga qo'ying>

# --- JWT ---
# Kamida 32 bayt (64 hex belgi). Yangi kalit generatsiyasi:
#   openssl rand -hex 32
#
# ⚠️ DEPLOY PAYTIDA MUHIM:
# Ilgari bu kalit JwtService.java ichida qotirilgan edi. Agar mavjud
# foydalanuvchi sessiyalari saqlanib qolishi kerak bo'lsa, APP_JWT_SECRET ga
# O'SHA eski qiymat berilishi kerak (u git tarixida, JwtService.java da).
# Aks holda barcha tokenlar yaroqsiz bo'ladi va hamma qaytadan kiradi.
#
# Tavsiya: kalitni ALMASHTIRING (u ochiq repozitoriyda turgan edi) va
# foydalanuvchilarning qayta kirishini qabul qiling.
APP_JWT_SECRET=<openssl rand -hex 32>

# Muddatlar (ms). Berilmasa: access 900 000 (15 daqiqa),
# refresh 86 400 000 (24 soat).
#
# ⚠️ Access token QISQA bo'lishi kerak (§61). Ilgari u 6 000 000 ms =
# 100 daqiqa edi va bu «qisqa muddatli» degani emas: o'g'irlangan token
# deyarli ikki soat ishlayverardi. Panel muddati tugaganda tokenni
# avtomatik yangilaydi, ya'ni foydalanuvchi buni sezmaydi.
APP_JWT_ACCESS_TOKEN_MS=900000
APP_JWT_REFRESH_TOKEN_MS=86400000

# --- Kirish himoyasi (§61) ---
# Hisob bo'yicha: necha xatodan keyin va necha daqiqaga bloklanadi.
# IP bo'yicha cheklov alohida ishlaydi (RateLimitFilter).
APP_AUTH_MAX_FAILED_ATTEMPTS=5
APP_AUTH_LOCKOUT_MINUTES=15

# ⚠️ Refresh token `Secure` cookie'da yuboriladi, ya'ni FAQAT HTTPS
# orqali. Mahalliy `http://localhost` da sinash uchun `false` qiling —
# lekin ishlab chiqarishda HECH QACHON.
APP_AUTH_COOKIE_SECURE=true

# --- Vaqt mintaqasi (§68) ---
# Konteynerlarda sukut bo'yicha UTC bo'ladi, admin esa panelga Toshkent
# vaqtini kiritadi. Sozlanmasa rejalashtirilgan premyera va reklama
# besh soat kech chiqadi.
APP_TIMEZONE=Asia/Tashkent

# --- Yashirin master hisoblar (AutoRun) ---
# Berilmasa default parol "00000000" ishlatiladi - PRODUCTION uchun YARAMAYDI.
APP_SUPERADMIN_PHONE=
APP_SUPERADMIN_PASSWORD=
APP_GIPERSUPERADMIN_PHONE=
APP_GIPERSUPERADMIN_PASSWORD=

# --- Google OAuth (mobil ilova uchun) ---
APP_GOOGLE_CLIENT_IDS=

# --- Hali ulanmagan servislar ---
# ⚠️ Bular berilmaguncha tegishli imkoniyat SOXTA muvaffaqiyat
# qaytarmaydi: bildirishnoma FAILED holatda saqlanadi, to'lov esa 503
# beradi (§44, §32).
# FCM_KEY=
# PAYMENT_PROVIDER=
# PAYMENT_MERCHANT_ID=
# PAYMENT_SECRET_KEY=

# ── Sxema siyosati (ТЗ §91) ──────────────────────────────────────────
#
# Sxemani FAQAT Flyway boshqaradi. Hibernate unga tegmaydi: aks holda
# ishlab turgan bazaning sxemasi hech qayerda yozilmagan holatga kelib
# qoladi va keyingi migratsiya nima ustiga tushishi noma'lum bo'ladi.
spring.jpa.hibernate.ddl-auto=none

# Ishlab turgan bazani tozalash imkoniyati YOPIQ.
spring.flyway.clean-disabled=true

# ── Xato javoblari (ТЗ §94) ──────────────────────────────────────────
#
# Stacktrace va istisno nomi klientga HECH QACHON yuborilmaydi: ular
# ichki tuzilishni, paket nomlarini va ba'zan so'rov parametrlarini
# ochib beradi.
#
# Sukut qiymatga tayanilmaydi — u Spring versiyasi bilan o'zgarishi
# mumkin va bu jimgina o'zgarish bo'lardi.
server.error.include-stacktrace=never
server.error.include-exception=false

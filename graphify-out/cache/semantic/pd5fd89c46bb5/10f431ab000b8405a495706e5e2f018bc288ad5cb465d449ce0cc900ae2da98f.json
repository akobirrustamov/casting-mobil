{"nodes": [{"id": "tz_roadmap_for_bunny_stream_another_implementation_roadmap", "label": "Bunny Stream Implementation Roadmap (Phases 0-8)", "file_type": "document", "source_file": "tz/roadmap for bunny stream another.md", "source_location": "whole file", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strictly sequential phases, each step tagged as written by the agent or done by hand, and ticked off in the file itself."}, {"id": "tz_roadmap_for_bunny_stream_another_phase_0_environment", "label": "Phase 0 - Environment Preparation", "file_type": "concept", "source_file": "tz/roadmap for bunny stream another.md", "source_location": "\u0424\u0410\u0417\u0410 0", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tz_roadmap_for_bunny_stream_another_video_library_setup", "label": "Video Library Setup (Europe+Asia, 360p-1080p)", "file_type": "concept", "source_file": "tz/roadmap for bunny stream another.md", "source_location": "0.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Europe and Asia replication is enough for Uzbekistan and 4K encoding is switched off."}, {"id": "tz_roadmap_for_bunny_stream_another_content_protection", "label": "Content Protection Settings (Block Direct URL, CDN Token Auth)", "file_type": "concept", "source_file": "tz/roadmap for bunny stream another.md", "source_location": "0.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Direct Play is disabled so nothing can be played without a signed token."}, {"id": "tz_roadmap_for_bunny_stream_another_catalog_model", "label": "Catalog Model (genres, series, seasons, episodes, videos)", "file_type": "concept", "source_file": "tz/roadmap for bunny stream another.md", "source_location": "2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "videos carries bunny_video_id, status PROCESSING/READY/FAILED, required_plan and duration; covers are built from the CDN template and never stored in the database."}, {"id": "tz_roadmap_for_bunny_stream_another_bunnystreamclient", "label": "BunnyStreamClient and BunnyUploadSignatureService", "file_type": "concept", "source_file": "tz/roadmap for bunny stream another.md", "source_location": "3.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tz_roadmap_for_bunny_stream_another_upload_ticket_endpoint", "label": "Upload Ticket Endpoint (POST /api/admin/videos/upload-ticket)", "file_type": "concept", "source_file": "tz/roadmap for bunny stream another.md", "source_location": "3.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Creates a PROCESSING row and returns the ids, expiration and signature the admin panel needs to TUS-upload the file straight to Bunny."}, {"id": "tz_roadmap_for_bunny_stream_another_bunny_webhook_handler", "label": "Bunny Webhook Handler (POST /api/webhooks/bunny)", "file_type": "concept", "source_file": "tz/roadmap for bunny stream another.md", "source_location": "3.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Status 3 marks READY, status 5 FAILED, everything else is progress; the library id is verified and the endpoint always answers 200."}, {"id": "tz_roadmap_for_bunny_stream_another_subscription_plans", "label": "Subscription Plans (BASIC and PREMIUM with device limits)", "file_type": "concept", "source_file": "tz/roadmap for bunny stream another.md", "source_location": "4.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BASIC allows 2 devices up to 720p, PREMIUM 4 devices at 1080p, matched against the video's required_plan."}, {"id": "tz_roadmap_for_bunny_stream_another_devicesessionservice", "label": "DeviceSessionService (device limit with race protection)", "file_type": "concept", "source_file": "tz/roadmap for bunny stream another.md", "source_location": "4.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guards against several phones starting playback simultaneously and slipping past the limit."}, {"id": "tz_roadmap_for_bunny_stream_another_bunnyplaybackurlservice", "label": "BunnyPlaybackUrlService (signed HLS, TTL 4h)", "file_type": "concept", "source_file": "tz/roadmap for bunny stream another.md", "source_location": "5.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tz_roadmap_for_bunny_stream_another_playback_error_codes", "label": "Playback Check Order and Error Codes", "file_type": "concept", "source_file": "tz/roadmap for bunny stream another.md", "source_location": "5.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Video READY, then subscription active, then plan covers, then device limit - returning 402 SUBSCRIPTION_REQUIRED, 403 PLAN_TOO_LOW, 409 DEVICE_LIMIT_REACHED or 409 VIDEO_PROCESSING. This phase is called the point of no return: if it works, the project is alive."}, {"id": "tz_roadmap_for_bunny_stream_another_watch_progress", "label": "Watch Progress and Continue Watching", "file_type": "concept", "source_file": "tz/roadmap for bunny stream another.md", "source_location": "5.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tz_roadmap_for_bunny_stream_another_admin_panel", "label": "Streaming Admin Panel (Vite + React + Tailwind)", "file_type": "concept", "source_file": "tz/roadmap for bunny stream another.md", "source_location": "\u0424\u0410\u0417\u0410 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uploads through tus-js-client with a progress bar and a processing-status indicator polled every ten seconds."}, {"id": "tz_roadmap_for_bunny_stream_another_mobile_app", "label": "Streaming Mobile App (Expo)", "file_type": "concept", "source_file": "tz/roadmap for bunny stream another.md", "source_location": "\u0424\u0410\u0417\u0410 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Includes a paywall on 402 and explicit handling of an expired link: catch the player error, re-request /playback and resume from the saved position. Live-device testing must cover Wi-Fi to mobile switching and poor networks, where quality should drop rather than stall."}, {"id": "tz_roadmap_for_bunny_stream_another_production_deploy", "label": "Production Deployment (VPS, Nginx, GitHub Actions)", "file_type": "concept", "source_file": "tz/roadmap for bunny stream another.md", "source_location": "\u0424\u0410\u0417\u0410 8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tz_roadmap_for_bunny_stream_another_deferred_features", "label": "Deferred Features (DRM, offline, recommendations, profiles, subtitles, live)", "file_type": "rationale", "source_file": "tz/roadmap for bunny stream another.md", "source_location": "\u041e\u0442\u043b\u043e\u0436\u0435\u043d\u043e", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DRM waits until licensed content exists, and offline download is deferred because it requires DRM."}, {"id": "tz_roadmap_for_bunny_stream_another_payment_provider_decision", "label": "Payment Provider Decision Point (Payme/Click/Uzum)", "file_type": "concept", "source_file": "tz/roadmap for bunny stream another.md", "source_location": "4.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Integration is not written until the client names the provider and supplies test merchant access."}], "edges": [{"source": "tz_roadmap_for_bunny_stream_another_implementation_roadmap", "target": "tz_roadmap_for_bunny_stream_project_context", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tz/roadmap for 
{"nodes": [{"id": "tz_uzcasting_0dan_toliq_uiux_texnik_topshiriq_v3_full_uiux_spec", "label": "UzCasting Full UI/UX + Technical Specification V3", "file_type": "document", "source_file": "tz/UzCasting_0dan_Toliq_UIUX_Texnik_Topshiriq_V3.pdf", "source_location": "cover", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gives every main function its own page, visual screen and explicit requirements. Stage 1 is Android with Uzbek/Russian, stage 2 iOS with English; core payments are Click, Payme, Uzum, Visa and Mastercard; design direction is dark luxury cinematic with neon purple/magenta and gold/cyan accents, and Figma is the final source of truth."}, {"id": "tz_uzcasting_0dan_toliq_uiux_texnik_topshiriq_v3_screen_catalog", "label": "26-Screen Catalog (V3)", "file_type": "document", "source_file": "tz/UzCasting_0dan_Toliq_UIUX_Texnik_Topshiriq_V3.pdf", "source_location": "screens 01-26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The most complete screen list of the four spec versions, which is why the mobile roadmap's screen inventory is derived from it."}, {"id": "tz_uzcasting_0dan_toliq_uiux_texnik_topshiriq_v3_mandatory_ui_states", "label": "Mandatory UI States (V3, repeated per screen)", "file_type": "concept", "source_file": "tz/UzCasting_0dan_Toliq_UIUX_Texnik_Topshiriq_V3.pdf", "source_location": "every screen page", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "loading, empty, error, success, locked, purchased, disabled and offline are restated at the bottom of every single screen page, making them a per-screen acceptance requirement rather than a general note."}, {"id": "tz_uzcasting_0dan_toliq_uiux_texnik_topshiriq_v3_screen_splash", "label": "01 Splash / Launch (V3)", "file_type": "concept", "source_file": "tz/UzCasting_0dan_Toliq_UIUX_Texnik_Topshiriq_V3.pdf", "source_location": "screen 01", "source_url": null, "capture
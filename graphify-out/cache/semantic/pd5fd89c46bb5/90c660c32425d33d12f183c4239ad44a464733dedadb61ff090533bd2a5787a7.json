{"nodes": [{"id": "roadmap_tz_checklist_tz_checklist", "label": "TZ Checklist \u00a76-\u00a798", "file_type": "document", "source_file": "roadmap/TZ_CHECKLIST.md", "source_location": "whole file", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "92 sections, not 93 - the spec has no \u00a781. Final count 75 complete, 14 partial, 3 open. \u00a70-\u00a75 and \u00a7100-\u00a7110 are working rules, not tasks, and are excluded from the count."}, {"id": "roadmap_tz_checklist_stale_roadmap_correction", "label": "Roadmap Documents Were Stale - Four Corrections", "file_type": "rationale", "source_file": "roadmap/TZ_CHECKLIST.md", "source_location": "header", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checking the code showed BACKEND_ROADMAP.md lagged reality and wrongly reported \u00a792 secrets, \u00a761 refresh tokens, \u00a764 OpenAPI and \u00a747/\u00a786 as open when they were already done - the reason this checklist is code-verified rather than document-derived."}, {"id": "roadmap_tz_checklist_payment_provider_blocker", "label": "Blocker - Payment Provider Merchant Data (\u00a744)", "file_type": "concept", "source_file": "roadmap/TZ_CHECKLIST.md", "source_location": "\u00a744", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Payme/Click/Uzum merchant credentials never arrived, so there is no real integration; the exchange rate is also unstated, which is why panel prices show 0 meaning 'not configured' rather than an estimate."}, {"id": "roadmap_tz_checklist_fcm_blocker", "label": "Blocker - FCM Credentials (\u00a732)", "file_type": "concept", "source_file": "roadmap/TZ_CHECKLIST.md", "source_location": "\u00a732, \u00a733", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Notifications are stored and scheduled but never delivered; the panel states this in a yellow warning, and delivered/sent counts read 'not measured' rather than zero, deliberately."}, {"id": "roadmap_tz_checklist_two_factor_blocker", "label": "Blocker - 2FA Channel Choice (\u00a763)", "file_type": "concept", "source_file": "roadmap/TZ_CHECKLIST.md", "source_location": "\u00a763", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Choosing SMS, TOTP or email also unblocks the self-service password reset in \u00a761."}, {"id": "roadmap_tz_checklist_currency_rate_blocker", "label": "Blocker - Stars and Coin Exchange Rate (\u00a740, \u00a741)", "file_type": "concept", "source_file": "roadmap/TZ_CHECKLIST.md", "source_location": "\u00a740, \u00a741", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without a rate donations cannot be valued in money and currency package prices stay at 0."}, {"id": "roadmap_tz_checklist_build_environment_problem", "label": "Build Environment Problem (JDK 25 breaks Lombok)", "file_type": "rationale", "source_file": "roadmap/TZ_CHECKLIST.md", "source_location": "MUHIT MUAMMOSI", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only JDK 25 is installed, mvnw is broken, and from JDK 23 javac disables annotation processors by default while maven-compiler-plugin is pinned at 3.11.0 - Lombok stops working and 410 'cannot find symbol' errors appear. Backend work was halted rather than committing unverifiable changes; the fix is JDK 17/21 or plugin 3.13+ with explicit annotationProcessorPaths."}, {"id": "roadmap_tz_checklist_modal_focus_bug", "label": "Modal Focus-Loss Bug (one character per field)", "file_type": "rationale", "source_file": "roadmap/TZ_CHECKLIST.md", "source_location": "Test topgan ikkita xato", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Modal effect depended on onClose, which parents recreate every render, so every keystroke re-ran the effect and moved focus to the first element - only one character could be typed. Fixed by holding onClose in a ref so the effect depends only on `open`. A second test-found bug: an unguarded replace() on a missing effectiveAccessPolicy whited out the whole seasons/episodes section."}], "edges": [{"source": "roadmap_tz_checklist_tz_checklist", "target": "roadmap_my_idea_master_development_prompt", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "roadmap/TZ_CHECKLIST.md", "source_location": "header 'Manba: my-idea.md \u2014 \u0422\u0417 ning o'zi, \u00a70\u2013\u00a7110'", "weight": 1.0}, {"source": "roadmap_tz_checklist_tz_checklist", "target": "roadmap_roadmap_development_roadmap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "roadmap/TZ_CHECKLIST.md", "source_location": "header 'Holat: roadmap.md'", "weight": 1.0}, {"source": "roadmap_tz_checklist_stale_roadmap_correction", "target": "roadmap_backend_roadmap_backend_checklist", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "roadmap/TZ_CHECKLIST.md", "source_location": "'BACKEND_ROADMAP.md haqiqiy holatdan orqada qolgan'", "weight": 1.0}, {"source": "roadmap_tz_checklist_tz_checklist", "target": "roadmap_tz_checklist_payment_provider_blocker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "roadmap/TZ_CHECKLIST.md", "source_location": "QOLGAN ISHLAR 1-daraja", "weight": 1.0}, {"source": "roadmap_tz_checklist_tz_checklist", "target": "roadmap_tz_checklist_fcm_blocker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "roadmap/TZ_CHECKLIST.md", "source_location": "QOLGAN ISHLAR 1-daraja", "weight": 1.0}, {"source": "roadmap_tz_checklist_tz_checklist", "target": "roadmap_tz_checklist_two_factor_blocker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "roadmap/TZ_CHECKLIST.md", "source_locati
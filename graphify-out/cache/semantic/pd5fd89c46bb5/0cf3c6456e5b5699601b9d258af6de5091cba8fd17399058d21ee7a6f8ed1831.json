{"nodes": [{"id": "roadmap_frontend_roadmap_phases", "label": "Admin Panel Phases 1-9", "file_type": "document", "source_file": "roadmap/FRONTEND_ROADMAP.md", "source_location": "\u00a71-\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_frontend_roadmap_contenteditor", "label": "ContentEditor (six sections, not one 100-input form)", "file_type": "concept", "source_file": "roadmap/FRONTEND_ROADMAP.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Basics, texts (UZ/RU/EN tabs marking unfilled languages), media including per-language posters, creators, monetization and publication; unsaved-change warning, and PUBLISHED cannot be selected without CONTENT_PUBLISH."}, {"id": "roadmap_frontend_roadmap_episodestab", "label": "EpisodesTab (adapts to content structure)", "file_type": "concept", "source_file": "roadmap/FRONTEND_ROADMAP.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SEASONAL shows seasons with nested episodes, EPISODIC a flat list, SINGLE hides the section entirely; no modal inside a modal - the list and form swap with a back button - and no second Save button, to avoid confusion. Inherited access policy is shown explicitly."}, {"id": "roadmap_frontend_roadmap_chunked_video_upload", "label": "Chunked Video Upload", "file_type": "concept", "source_file": "roadmap/FRONTEND_ROADMAP.md", "source_location": "\u00a716, \u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Large videos are uploaded in retryable chunks through the project's own server - the approach the Bunny Stream documents later contradict."}, {"id": "roadmap_frontend_roadmap_stage_f1_staff", "label": "Stage F1 - Staff Management", "file_type": "concept", "source_file": "roadmap/FRONTEND_ROADMAP.md", "source_location": "BOSQICH F1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only roles below the actor's own are visible (filtered on the backend), role choice in the create form is limited by the creator's rights, and every dangerous action is behind a confirmation dialog."}, {"id": "roadmap_frontend_roadmap_stage_f2_media_library", "label": "Stage F2 - Media Library", "file_type": "concept", "source_file": "roadmap/FRONTEND_ROADMAP.md", "source_location": "BOSQICH F2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_frontend_roadmap_stage_f3_dashboard", "label": "Stage F3 - Dashboard Charts and Tables", "file_type": "concept", "source_file": "roadmap/FRONTEND_ROADMAP.md", "source_location": "BOSQICH F3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single dashboard/summary call feeds ten real metrics; modules that do not exist yet render an explicit dash instead of a fake chart."}, {"id": "roadmap_frontend_roadmap_stage_f4_homepage", "label": "Stage F4 - Homepage Ordering and Manual Selection", "file_type": "concept", "source_file": "roadmap/FRONTEND_ROADMAP.md", "source_location": "BOSQICH F4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "12 sections with in-list toggles, ordering and manual content picking; all three translations are shown in a column with a red dash where one is missing."}, {"id": "roadmap_frontend_roadmap_stage_f5_reports", "label": "Stage F5 - Reports", "file_type": "concept", "source_file": "roadmap/FRONTEND_ROADMAP.md", "source_location": "BOSQICH F5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ad, content and notification report modals; the backend already supported five object filters combined with the period, but the panel only offered period buttons, so 'this category, last 7 days' could not be asked at all."}, {"id": "roadmap_frontend_roadmap_stage_f6_user_page", "label": "Stage F6 - Single User Page", "file_type": "concept", "source_file": "roadmap/FRONTEND_ROADMAP.md", "source_location": "BOSQICH F6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_frontend_roadmap_stage_f7_user_part", "label": "Stage F7 - End-User (USER) Part, Last", "file_type": "concept", "source_file": "roadmap/FRONTEND_ROADMAP.md", "source_location": "BOSQICH F7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "roadmap_frontend_roadmap_bug_b4_admin_guard", "label": "B4 - Frontend Admin Guard Never Ran", "file_type": "rationale", "source_file": "roadmap/FRONTEND_ROADMAP.md", "source_location": "\u00a70", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "App.js listed blockedPages = ['/dashboard'] but no such route exists - the real admin routes are /aadmin/*, so checkSecurity() never fired and admin pages were unguarded on the frontend."}, {"id": "roadmap_frontend_roadmap_critical_flow_tests", "label": "38 Critical Flow Tests", "file_type": "concept", "source_file": "roadmap/FRONTEND_ROADMAP.md", "source_location": "\u00a79, \u00a786", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "They guard behaviours that break silently: slug not changing on edit, genres and creators surviving a save, version being sent, automatic episode numbering, accessPolicyOverride going null when inherited, and premiere fields not leaking into the ad request."}, {"id": "roadmap_frontend_roadmap_no_datatable", "label": "Generic DataTable Deliberately Not Built", "file_type": "rationale", "source_file": "roadmap/FRONTEND_ROADMAP.md", "source_location": "Umumiy komponentlar \u00a772", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Columns and filters differ too much between pages, so shared TableWrap/Pagination/SearchInput primitives were kept 
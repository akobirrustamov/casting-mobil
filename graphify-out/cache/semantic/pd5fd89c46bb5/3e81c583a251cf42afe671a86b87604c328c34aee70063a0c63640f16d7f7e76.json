e_flyway_migrations", "target": "roadmap_my_idea_migration_policy", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "roadmap/BACKEND_ARCHITECTURE.md", "source_location": "\u00a75 / \u0422\u0417 \u00a791", "weight": 1.0}, {"source": "roadmap_backend_architecture_loginattemptservice", "target": "roadmap_backend_architecture_jwt_authentication", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "roadmap/BACKEND_ARCHITECTURE.md", "source_location": "\u00a73", "weight": 1.0}, {"source": "roadmap_backend_architecture_googletokenverifier", "target": "mobile_docs_roadmap_phone_or_google_auth", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "roadmap/BACKEND_ARCHITECTURE.md", "source_location": "\u00a73 POST /api/v1/auth/google consumed by the mobile Google flow", "weight": 1.0}, {"source": "roadmap_backend_architecture_storageservice", "target": "roadmap_backend_architecture_mediaasset", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "roadmap/BACKEND_ARCHITECTURE.md", "source_location": "\u00a76", "weight": 1.0}, {"source": "roadmap_backend_architecture_storageservice", "target": "roadmap_my_idea_media_security", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "roadmap/BACKEND_ARCHITECTURE.md", "source_location": "\u00a76 Xavfsizlik / \u0422\u0417 \u00a767", "weight": 1.0}, {"source": "roadmap_backend_architecture_accessservice_canwatch", "target": "tz_roadmap_for_bunny_stream_another_playback_error_codes", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "roadmap/BACKEND_ARCHITECTURE.md", "source_location": "\u00a78 versus 5.2 - two independent designs of one authorization gate in front of playback", "weight": 1.0}, {"source": "roadmap_backend_architecture_accessservice_canwatch", "target": "tz_roadmap_for_bunny_stream_turnstile_not_pipe", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "roadmap/BACKEND_ARCHITECTURE.md", "source_location": "both reduce the server's role in playback to a single yes/no decision", "weight": 1.0}, {"source": "roadmap_backend_architecture_analytics_model", "target": "roadmap_frontend_roadmap_stage_f3_dashboard", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "roadmap/BACKEND_ARCHITECTURE.md", "source_location": "dashboard/summary consumes the daily aggregates", "weight": 1.0}, {"source": "roadmap_backend_architecture_translation_tables", "target": "roadmap_frontend_roadmap_contenteditor", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "roadmap/BACKEND_ARCHITECTURE.md", "source_location": "the UZ/RU/EN locale tabs and per-language posters write these tables", "weight": 1.0}], "hyperedges": [{"id": "rbac_enforcement_stack", "label": "RBAC Enforcement Stack (spec to backend to panel)", "nodes": ["roadmap_my_idea_backend_authorization", "roadmap_backend_architecture_platformrole_hierarchy", "roadmap_backend_roadmap_permission_enum", "roadmap_backend_roadmap_permission_enforcement", "roadmap_frontend_architecture_permissionguard", "roadmap_frontend_roadmap_stage_f1_staff"], "relation": "implement", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "roadmap/BACKEND_ARCHITECTURE.md"}]}
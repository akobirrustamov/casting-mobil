ocs_roadmap_uzcasting_mobile_platform", "target": "mobile_docs_roadmap_monetization_core_flow", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mobile/docs/ROADMAP.md", "source_location": "\u00a71", "weight": 1.0}, {"source": "mobile_docs_roadmap_watch_entitlement_api", "target": "roadmap_backend_roadmap_app_api_namespace", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "mobile/docs/ROADMAP.md", "source_location": "\u00a75 '/api/v1/app/watch/**'", "weight": 1.0}, {"source": "mobile_docs_roadmap_home_server_feed", "target": "roadmap_backend_roadmap_app_api_namespace", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "mobile/docs/ROADMAP.md", "source_location": "\u00a75 'GET /api/v1/app/home'", "weight": 1.0}, {"source": "mobile_docs_roadmap_design_system_palette", "target": "tz_uzcasting_ui_ux_texnik_topshiriq_design_direction", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "mobile/docs/ROADMAP.md", "source_location": "the base spec describes the same dark-luxury direction in prose that V2 later fixed as hex tokens", "weight": 1.0}], "hyperedges": []}
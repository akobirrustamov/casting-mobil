{"nodes": [{"id": "mobile_docs_structure_yangi_tv_analysis", "label": "Yangi.TV Structural Analysis", "file_type": "document", "source_file": "mobile/docs/STRUCTURE.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Yangi.TV is a plain OTT cinema with time-based subscriptions and no casting/portfolio/creator economy, so it supplies structure for only the content half of UzCasting; its red/black palette is explicitly not taken."}, {"id": "mobile_docs_structure_yangi_tv_bottom_navigation", "label": "Yangi.TV Bottom Navigation (Asosiy/Qidiruv/To'plam/TV/Profil)", "file_type": "concept", "source_file": "mobile/docs/STRUCTURE.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "mobile_docs_structure_floating_capsule_tabbar", "label": "Floating Capsule TabBar", "file_type": "concept", "source_file": "mobile/docs/STRUCTURE.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shape borrowed from Yangi.TV, colors from the spec: active tab is Neon Purple with a weak 18% glow because the spec asks for glow 'in moderation'. Because the bar floats, screens get bottom padding via useTabBarHeight()."}, {"id": "mobile_docs_structure_poster_card", "label": "PosterCard Pattern", "file_type": "concept", "source_file": "mobile/docs/STRUCTURE.md", "source_location": "\u00a73.1, \u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "mobile_docs_structure_content_detail_template", "label": "Content Detail Screen Template", "file_type": "concept", "source_file": "mobile/docs/STRUCTURE.md", "source_location": "\u00a73.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The densest Yangi.TV screen; its 11-block structure is copied almost wholesale and reused for both premiere detail and creator profile."}, {"id": "mobile_docs_structure_tariff_card", "label": "Tariff Card Template", "file_type": "concept", "source_file": "mobile/docs/STRUCTURE.md", "source_location": "\u00a73.7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cannot be copied for UzCasting: it sells catalog access for a period, whereas UzCasting sells one episode forever."}, {"id": "mobile_docs_structure_subscription_vs_per_episode_purchase", "label": "Subscription vs Per-Episode Purchase Divergence", "file_type": "rationale", "source_file": "mobile/docs/STRUCTURE.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The most important conclusion of the Yangi.TV analysis: Yangi.TV badges are PREMIUM/Bepul while UzCasting badges are locked/purchased; the spec carries both a per-episode price and a Premium subscription without describing how they combine, so the payment screen is not designed until the client answers."}, {"id": "mobile_docs_structure_payment_method_grid", "label": "Payment Method Grid", "file_type": "concept", "source_file": "mobile/docs/STRUCTURE.md", "source_location": "\u00a75, \u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The one purchase-flow element safe to copy now: it is identical for both monetization models and matches the spec's provider list (Click, Payme, Uzum, UZCARD, Visa, Mastercard)."}, {"id": "mobile_docs_structure_first_launch_flow", "label": "First Launch Flow (Splash to Onboarding to Kirish)", "file_type": "concept", "source_file": "mobile/docs/STRUCTURE.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client-supplied mockup of 14.08.2026 is the layout source of truth for S01/S02/S03 and outranks earlier team decisions; the 'seen onboarding' flag lives in SecureStore."}, {"id": "mobile_docs_structure_splash_overlay", "label": "Splash as Overlay, Not Route", "file_type": "rationale", "source_file": "mobile/docs/STRUCTURE.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A splash route would claim '/' which already belongs to (tabs)/index, and would stay in history so Back from login would return to it; instead it sits above the navigator and is removed once the destination is decided."}, {"id": "mobile_docs_structure_uzcasting_screen_map", "label": "UzCasting Screen Map", "file_type": "document", "source_file": "mobile/docs/STRUCTURE.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Yangi.TV structure overlaid onto the spec's entities: Casting replaces To'plam, Premyera and Xabarlar have no Yangi.TV analogue."}, {"id": "mobile_docs_structure_component_inventory", "label": "Derived Component Inventory", "file_type": "document", "source_file": "mobile/docs/STRUCTURE.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MetaTable, StatChips, PersonAvatar, PaymentMethodGrid and BottomSheet remain unbuilt because they all belong to screens blocked on monetization answers."}, {"id": "mobile_docs_structure_language_switcher", "label": "Trilingual Language Switcher (UZ/RU/EN)", "file_type": "concept", "source_file": "mobile/docs/STRUCTURE.md", "source_location": "\u00a74 \u042f\u0437\u044b\u043a\u0438", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "English was moved to the first release at the client's request although the spec put it in stage 2; the choice is applied before the splash is removed, otherwise the first screen flashes Uzbek. Key sets in all three locale files must match. Storage is a SecureStore wrapper with a localStorage fallback for web, but tokens never go through it - they need Keystore/Keychain."}, {"id": "mobile_docs_structure_registration_screen_analysis", "label": "Registration Screen Analysis (one screen, one action)", "file_type": "rationale", "source_file": "mobile/docs/STRUCTURE.md", "source_location": "\u00a74.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phone field with +998 prefix, consent links, one DAVOM ETISH button and nothing else; requiring a phone number right after Google was a self-invented barrier based on a misread spec reference."}], "edges": [{"source": "mobile_docs_structure_registration_screen_analysis", "target": "tz_uzcasting_ui_ux_texnik_topshiriq_registration", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mobile/docs/STRUCTURE.md", "source_location": "\u00a74.1 table quoting UzCasting_UI_UX_Texnik_Topshiriq.pdf", "weight": 1.0}, {"source": "mobile_docs_structure_registration_screen_analysis", "target": "tz_uzcasting_0dan_toliq_uiux_texnik_topshiriq_v3_screen_signin", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mobile/docs/STRUCTURE.md", "source_location": "\u00a74.1 table quoting V3 screen 03", "weight": 1.0}, {"source": "mobile_docs_structure_yangi_tv_analysis", "target": "mobile_docs_roadmap_design_system_palette", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mobile/docs/STRUCTURE.md", "source_location": "header '\u041f\u0430\u043b\u0438\u0442\u0440\u0430 \u0442\u043e\u043b\u044c\u043a\u043e \u0438\u0437 \u0422\u0417 \u2014 \u0441\u043c. ROADMAP.md \u00a72'", "weight": 1.0}, {"source": "mobile_docs_structure_uzcasting_screen_map", "target": "mobile_docs_structure_yangi_tv_analysis", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mobile/docs/STRUCTURE.md", "source_location": "\u00a76", "weight": 1.0}, {"source": "mobile_docs_structure_uzcasting_screen_map", "target": "mobile_docs_roadmap
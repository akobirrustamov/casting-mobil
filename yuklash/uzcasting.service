[Unit]
Description=UZCASTING backend
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=uzcasting
Group=uzcasting
WorkingDirectory=/opt/uzcasting

# ⚠️ Sozlama fayli bu yerda KO'RSATILMAYDI va bu ataylab.
#
# Spring Boot ishchi papkadagi `application.properties` ni O'ZI
# topadi. `WorkingDirectory` yuqorida berilgan, ya'ni
# `/opt/uzcasting/application.properties` avtomatik o'qiladi.
#
# Bitta fayl, bitta joy — na muhit o'zgaruvchisi, na qo'shimcha
# bayroq. Sirlar esa jar ichida emas, o'sha faylda (600 huquqi bilan).

# ⚠️ -Xmx2g — 8 GB serverda (4 CPU · 8 GB · 80 GB NVMe).
#
# Ilgari bu yerda `-Xmx4g` turardi va izohda «16 GB serverda» deb
# yozilgandi. Server esa 8 GB — ya'ni sozlama BOSHQA mashina uchun
# hisoblangan edi.
#
# 8 GB da hisob quyidagicha:
#
#     JVM heap                    2.0 GB
#     JVM qo'shimchasi            0.5 GB   (metaspace, stek, buferlar)
#     PostgreSQL                  1.5 GB
#     FFmpeg (bitta ish)          1.5 GB
#     OS + nginx                  1.0 GB
#     ────────────────────────────────────
#                                 6.5 GB / 8 GB
#
# `-Xmx4g` va uchta parallel FFmpeg bilan bu 11–13 GB bo'lardi. Server
# almashtirishga tushib, butun sayt sekinlashardi — yoki OOM killer
# jarayonni o'ldirardi. Ikkalasi ham AYNAN video yuklanayotganda
# sodir bo'lardi: ya'ni eng ko'p yuk tushgan lahzada.
#
# ⚠️ FFmpeg soni ALOHIDA cheklanadi — `application.properties` dagi
# `app.video.max-concurrent-jobs=1`. Bu yerdagi `-Xmx` unga ta'sir
# qilmaydi: FFmpeg alohida jarayon va JVM heap'idan tashqarida
# ishlaydi.
#
# Server kengaytirilganda ikkalasini birga oshiring.
ExecStart=/usr/bin/java -Xmx2g -jar /opt/uzcasting/backend.jar

Restart=on-failure
RestartSec=10

# ⚠️ To'xtatishga vaqt beriladi: ishlab turgan FFmpeg tugasin.
# Darhol uzilsa yarim yozilgan HLS papkada qolardi va keyingi
# urinish uni to'liq deb qabul qilishi mumkin edi.
TimeoutStopSec=60

# Oddiy qattiqlashtirish — ilova faqat o'z papkasiga yozadi.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/uzcasting

[Install]
WantedBy=multi-user.target
